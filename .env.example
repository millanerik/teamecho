# Copy this file to ".env.local" and fill in your Supabase project values.
# Find them in Supabase: Project Settings -> API
#
# The "anon public" key is safe to expose in a browser app.
# Never put the "service_role" key in here or anywhere client-side.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GIPHY search (optional but needed for the "Search GIFs" board feature).
# Free key at https://developers.giphy.com -> Create an App -> copy the API Key.
# This is a browser/public key and is safe to expose in a client app.
VITE_GIPHY_API_KEY=your-giphy-api-key
